        "backgroundColor": "#ffffff"
      },
      "package": "com.Capstone.FeedbackApk"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ecc89e66-346a-4e48-b769-9559ce4a0e88"
      }
