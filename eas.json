{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SUPABASE_URL": "$SUPABASE_URL",
        "SUPABASE_ANON_KEY": "$SUPABASE_ANON_KEY",
        "AZURE_SPEECH_KEY": "$AZURE_SPEECH_KEY",
        "AZURE_SPEECH_REGION": "$AZURE_SPEECH_REGION"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "SUPABASE_URL": "$SUPABASE_URL",
        "SUPABASE_ANON_KEY": "$SUPABASE_ANON_KEY",
        "AZURE_SPEECH_KEY": "$AZURE_SPEECH_KEY",
        "AZURE_SPEECH_REGION": "$AZURE_SPEECH_REGION"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
